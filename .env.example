# Plantilla de variables de entorno. Copiala a .env y completá tu API key:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Única variable OBLIGATORIA para correr `python -m src.main`: la API key del
# proveedor elegido en LLM_PROVIDER (ANTHROPIC_API_KEY por default;
# OPENAI_API_KEY si LLM_PROVIDER=openai; ninguna con ollama). Todas las demás
# tienen default (el valor que figura acá). Los tests (`pytest`) no necesitan
# ninguna.
#
# La base vectorial es ChromaDB LOCAL (lo que pide la consigna), no Pinecone:
# no hay API key, índice ni región de base vectorial que configurar. Sus
# equivalentes son la carpeta de persistencia y el nombre de la colección.

# --- LLM de generación (src/chain.py::_build_model) --------------------------
# Proveedor: anthropic (default) | openai | ollama. `python -m src.main`
# verifica al arrancar que la API key correspondiente esté cargada.
LLM_PROVIDER=anthropic
# OBLIGATORIA si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=tu_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Base vectorial ChromaDB (src/client.py) ---------------------------------
# Carpeta donde Chroma persiste la colección. Si es relativa, se resuelve
# contra la raíz del proyecto.
CHROMA_PERSIST_DIR=./vectorstore
# Nombre base de la colección (equivalente al nombre de índice en Pinecone).
# La colección real es <CHROMA_COLLECTION>_<RAG_ENV>.
CHROMA_COLLECTION=manuales_tecnicos
# Entorno: dev | prod. Una colección por entorno (equivalente a los
# namespaces de Pinecone), para que dev y prod no compartan vectores.
RAG_ENV=dev

# --- Embeddings (src/client.py::build_embeddings) ----------------------------
# Corre 100% local con sentence-transformers (se descarga una vez desde
# Hugging Face Hub y queda cacheado), sin API key. Si lo cambiás con la base ya
# persistida, borrá la carpeta de CHROMA_PERSIST_DIR y volvé a correr la
# ingesta: los vectores de modelos distintos no son compatibles entre sí.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Proveedores alternativos de generación ----------------------------------
# OBLIGATORIA si LLM_PROVIDER=openai.
OPENAI_API_KEY=tu_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Si LLM_PROVIDER=ollama: corre local, sin API key (requiere `ollama serve`).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
