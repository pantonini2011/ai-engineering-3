# Copiá este archivo a .env y completá tus API keys.

# Opcional: modelo de embeddings (indexación y consulta,
# rag/ingest.py::_build_embeddings). Corre 100% local con
# sentence-transformers (se descarga una vez desde Hugging Face Hub y queda
# cacheado en disco) -- no requiere API key. El default es la variante
# multilingüe (mejor para español que all-MiniLM-L6-v2, entrenado casi
# solo en inglés). Sólo hace falta setear esto si querés usar otro modelo.
# Importante: si lo cambiás con la base ya persistida, borrá ./vectorstore
# y volvé a correr la ingesta (los vectores de un modelo distinto no son
# compatibles entre sí).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Proveedor de generación (rag/chain.py::_build_model), por default "anthropic"
# (Claude) -- requerida para correr rag.main tal cual. "Local" en esta
# consigna describe a la base vectorial (ChromaDB), no al LLM de generación.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Opcional: solo si corrés rag.main o los tests con provider="openai".
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Opcional: solo si corrés rag.main o los tests con provider="ollama" (para
# generación -- Ollama ya no se usa para embeddings).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
